<script>
/* Intro */
(function(){
  const intro=document.getElementById('intro'),inner=document.getElementById('iin'),bar=document.getElementById('ibar');
  requestAnimationFrame(()=>setTimeout(()=>{inner.classList.add('show');bar.classList.add('grow');},80));
  setTimeout(()=>{
    inner.style.transition='opacity .55s,filter .55s,transform .55s';
    inner.style.opacity='0'; inner.style.filter='blur(10px)'; inner.style.transform='scale(1.04)';
    setTimeout(()=>{ intro.classList.add('out'); setTimeout(()=>intro.remove(),920); },460);
  },2800);
})();

/* Cursor */
const cd=document.getElementById('cd'),cr=document.getElementById('cr');
let rx=0,ry=0,dx=0,dy=0;
document.addEventListener('mousemove',e=>{dx=e.clientX;dy=e.clientY;cd.style.left=dx+'px';cd.style.top=dy+'px';});
(function a(){rx+=(dx-rx)*.16;ry+=(dy-ry)*.16;cr.style.left=rx+'px';cr.style.top=ry+'px';requestAnimationFrame(a);})();
document.querySelectorAll('a,button,.on,.pc,.cc').forEach(el=>{
  el.addEventListener('mouseenter',()=>cr.classList.add('big'));
  el.addEventListener('mouseleave',()=>cr.classList.remove('big'));
});

/* Nav scroll */
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>40),{passive:true});

/* Ticker */
const ti=['10+ Program Kerja Aktif','50+ Anggota Terlatih','Voting Ketua OSIS 2026','Daftar Sekarang','SMK Negeri 5 Telkom Banda Aceh','Inovatif · Inklusif · Berdampak'];
const te=document.getElementById('tk');
te.innerHTML=ti.map(t=>`<span style="display:inline-flex;align-items:center;gap:.625rem;padding:0 2.25rem;font-size:.62rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.38);white-space:nowrap">${t}<span style="color:rgba(255,255,255,.15);font-size:.4rem">&#9724;</span></span>`).join('')+''+ti.map(t=>`<span style="display:inline-flex;align-items:center;gap:.625rem;padding:0 2.25rem;font-size:.62rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.38);white-space:nowrap">${t}<span style="color:rgba(255,255,255,.15);font-size:.4rem">&#9724;</span></span>`).join('');

/* Reveal */
const ro=new IntersectionObserver(en=>en.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in');}),{threshold:.08});
document.querySelectorAll('.rv').forEach(el=>ro.observe(el));

/* Voting */
@if($showVoting)
@php
$candsData=$candidates->map(function($c,$i){return['id'=>$c->id,'name'=>$c->Nama_Ketua.' & '.$c->Nama_Wakil,'num'=>str_pad($i+1,2,'0',STR_PAD_LEFT),'tagline'=>$c->Visi.' — '.$c->Misi,'foto_ketua'=>$c->Foto_Ketua?asset('storage/'.$c->Foto_Ketua):'https://ui-avatars.com/api/?name='.urlencode($c->Nama_Ketua).'&background=f5f4f2&color=c41230&size=80&bold=true','foto_wakil'=>$c->Foto_Wakil?asset('storage/'.$c->Foto_Wakil):'https://ui-avatars.com/api/?name='.urlencode($c->Nama_Wakil).'&background=f5f4f2&color=c41230&size=80&bold=true','votes'=>$c->Jumlah_Suara];})->toArray();
@endphp
const cands=@json($candsData),isOpen={{ $isOpen?'true':'false' }},isLoggedIn={{ $isLoggedIn?'true':'false' }},voteUrl=isLoggedIn?'{{ route("vote") }}':'{{ route("login") }}';
function renderVote(){
  const g=document.getElementById('cGrid');if(!g)return;g.innerHTML='';
  const tot=cands.reduce((a,c)=>a+c.votes,0);
  cands.forEach((c,i)=>{
    const pct=tot>0?Math.round(c.votes/tot*100):0,top=i===0&&c.votes>0;
    const btn=isOpen?`<a href="${voteUrl}" style="display:block;width:100%;padding:.7rem;background:#C41230;color:white;text-decoration:none;border-radius:7px;font-family:'Syne',sans-serif;font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-align:center;transition:background .2s" onmouseover="this.style.background='#A00E27'" onmouseout="this.style.background='#C41230'">${isLoggedIn?'Vote Sekarang':'Mulai Voting'}</a>`:`<div style="width:100%;padding:.7rem;background:#F5F4F2;color:#9C9A98;border:1.5px solid #E8E6E4;border-radius:7px;font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;text-align:center">Voting Ditutup</div>`;
    const badge=top?`<div style="position:absolute;top:.875rem;right:.875rem;padding:.2rem .625rem;background:#C41230;border-radius:100px;font-size:.5rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:white">Terdepan</div>`:'';
    const el=document.createElement('div');el.className='cc';
    el.innerHTML=`<div style="background:#F5F4F2;padding:2.25rem 1.75rem 1.75rem;text-align:center;position:relative">${badge}<div style="position:absolute;top:.875rem;left:.875rem;width:26px;height:26px;background:#0A0908;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:.55rem;font-weight:700;color:white;font-family:'Syne',sans-serif">${c.num}</div><div style="display:flex;justify-content:center;gap:.625rem;margin-bottom:1.125rem"><img src="${c.foto_ketua}" alt="Ketua" style="width:58px;height:58px;border-radius:8px;object-fit:cover;border:1.5px solid rgba(196,18,48,.12);background:white"/><img src="${c.foto_wakil}" alt="Wakil" style="width:58px;height:58px;border-radius:8px;object-fit:cover;border:1.5px solid rgba(196,18,48,.12);background:white"/></div><div style="font-family:'Instrument Serif',serif;font-size:1.05rem;color:#0A0908;margin-bottom:.3rem">${c.name}</div><p style="font-size:.65rem;color:#9C9A98;line-height:1.6;max-height:2.5rem;overflow:hidden;margin:0">${c.tagline}</p></div><div style="padding:1.25rem 1.75rem"><div style="height:2px;background:#E8E6E4;border-radius:4px;margin-bottom:.5rem;overflow:hidden"><div class="vbar" style="height:100%;border-radius:4px;background:#C41230;width:${pct}%"></div></div><div style="display:flex;justify-content:space-between;font-size:.6rem;color:#9C9A98;margin-bottom:1.125rem;font-weight:600"><span>${c.votes} suara</span><span>${pct}%</span></div>${btn}</div>`;
    g.appendChild(el);
  });
  const tv=document.getElementById('vTotal');if(tv)tv.textContent=tot.toLocaleString('id-ID');
}
renderVote();
@endif

/* Legacy helpers */
function toggleForm(t){const f=document.getElementById('form'+t),b=document.getElementById('btn'+t);if(!f||!b)return;const o=f.classList.toggle('open');b.classList.toggle('open',o);b.textContent=o?'Tutup Formulir':'Buka Formulir Pendaftaran';b.style.background=o?'#C41230':'';b.style.color=o?'#fff':'';b.style.borderColor=o?'#C41230':'';}
function submitReg(t){const d=document.getElementById('done'+t);if(d){d.classList.remove('hidden');d.classList.add('block');}const f=document.getElementById('form'+t);if(f)f.querySelectorAll('input,select,textarea').forEach(el=>el.value='');}
</script>
</body>
</html>
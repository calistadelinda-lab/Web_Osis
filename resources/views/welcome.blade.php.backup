<style>
*,*::before,*::after{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'Syne',sans-serif;background:#F5F4F2;color:#0A0908;overflow-x:hidden;-webkit-font-smoothing:antialiased;}
*,a,button{cursor:none !important;}

/* ─ Cursor ─ */
#cd{position:fixed;top:0;left:0;width:6px;height:6px;background:#C41230;border-radius:50%;pointer-events:none;z-index:10000;transform:translate(-50%,-50%);}
#cr{position:fixed;top:0;left:0;width:26px;height:26px;border:1.5px solid rgba(196,18,48,.45);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:width .35s cubic-bezier(.22,1,.36,1),height .35s cubic-bezier(.22,1,.36,1),border-color .25s,background .25s;}
#cr.big{width:46px;height:46px;border-color:rgba(196,18,48,.2);background:rgba(196,18,48,.04);}

/* ─ Intro Loading ─ */
#intro{position:fixed;inset:0;z-index:9500;background:#080605;display:flex;align-items:center;justify-content:center;overflow:hidden;backdrop-filter:blur(40px);}
#intro::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 40% 40% at 50% 40%,rgba(196,18,48,.2) 0%,transparent 60%);}
#intro::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,transparent 0%,rgba(8,6,5,.3) 100%);pointer-events:none;}
#iglow{position:absolute;width:100%;height:100%;background:radial-gradient(ellipse 50% 50% at 50% 50%,rgba(196,18,48,.12) 0%,transparent 70%);animation:gp 4s ease-in-out infinite;}
@keyframes gp{0%{opacity:.5;transform:scale(.95)}50%{opacity:1;transform:scale(1.08)}100%{opacity:.5;transform:scale(.95)}}
#iin{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;opacity:0;filter:blur(18px);transform:scale(.92) translateY(12px);transition:opacity 1.2s cubic-bezier(.22,1,.36,1),filter 1.2s cubic-bezier(.22,1,.36,1),transform 1.2s cubic-bezier(.22,1,.36,1);}
#iin.show{opacity:1;filter:blur(0);transform:none;}
#intro-slogan{width:min(580px,86vw);display:block;filter:drop-shadow(0 0 50px rgba(196,18,48,.3));animation:pulseSlogan 2s cubic-bezier(.22,1,.36,1) 1s forwards;}
@keyframes pulseSlogan{0%{opacity:.4;filter:drop-shadow(0 0 40px rgba(196,18,48,.1)) blur(2px)}100%{opacity:1;filter:drop-shadow(0 0 50px rgba(196,18,48,.3)) blur(0)}}
#ibar{width:0;height:1px;background:rgba(196,18,48,.75);margin:2.25rem auto 0;transition:width 1.1s .4s cubic-bezier(.22,1,.36,1);}
#ibar.grow{width:72px;}
#isub{margin-top:1.5rem;font-size:.58rem;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:rgba(255,255,255,.15);}
#intro.out{animation:outSlide .95s cubic-bezier(.76,0,.24,1) forwards;}
@keyframes outSlide{to{opacity:0;transform:translateY(-120%);filter:blur(10px)}}

/* ─ Navbar ─ */
#nav{position:fixed;top:0;left:0;right:0;z-index:800;height:70px;display:flex;align-items:center;justify-content:space-between;padding:0 4rem;background:rgba(245,244,242,.72);backdrop-filter:blur(24px) saturate(1.6);-webkit-backdrop-filter:blur(24px) saturate(1.6);border-bottom:1px solid rgba(196,18,48,.06);transition:all .3s cubic-bezier(.22,1,.36,1);}
#nav.scrolled{background:rgba(245,244,242,.95);box-shadow:0 2px 32px rgba(10,9,8,.06);border-bottom:1px solid rgba(196,18,48,.08);}
.nl{position:relative;font-size:.65rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#5C5A58;text-decoration:none;padding:.4rem .75rem;transition:color .25s cubic-bezier(.22,1,.36,1);}
.nl::after{content:'';position:absolute;bottom:-2px;left:.75rem;right:.75rem;height:2px;background:#C41230;transform:scaleX(0);transform-origin:left;transition:transform .4s cubic-bezier(.22,1,.36,1);}
.nl:hover{color:#C41230;}.nl:hover::after{transform:scaleX(1);}
.btn-r{padding:.55rem 1.5rem;background:#C41230;color:#fff;text-decoration:none;border-radius:8px;font-size:.65rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase;box-shadow:0 6px 20px rgba(196,18,48,.25);transition:all .3s cubic-bezier(.22,1,.36,1);display:inline-block;border:none;cursor:pointer;}
.btn-r:hover{background:#A00E27;box-shadow:0 10px 32px rgba(196,18,48,.4);transform:translateY(-2px);}
.btn-o{padding:.55rem 1.25rem;background:transparent;border:1.5px solid rgba(196,18,48,.4);color:#5C5A58;text-decoration:none;border-radius:8px;font-size:.65rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase;transition:all .3s cubic-bezier(.22,1,.36,1);display:inline-block;cursor:pointer;}
.btn-o:hover{border-color:#C41230;color:#C41230;background:rgba(196,18,48,.03);}

/* ─ Hero ─ */
#beranda{padding-top:70px;min-height:100svh;background:#F5F4F2;overflow:hidden;position:relative;}
#beranda::before{content:'';position:absolute;top:50%;left:-20%;width:600px;height:600px;background:radial-gradient(circle,rgba(196,18,48,.04) 0%,transparent 70%);border-radius:50%;pointer-events:none;}
.hero-grid{max-width:1360px;margin:0 auto;padding:0 4rem;display:grid;grid-template-columns:1.1fr 1fr;min-height:calc(100svh - 70px);align-items:center;gap:5rem;position:relative;z-index:1;}
.hero-left{padding:4.5rem 0;}
.hero-right{height:min(85vh,750px);position:relative;margin-right:-2rem;}
.hero-img-box{position:absolute;inset:0;border-radius:20px;overflow:hidden;box-shadow:0 20px 60px rgba(10,9,8,.15);}
.hero-img-box img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;}
.hero-img-box::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(196,18,48,.08) 0%,rgba(196,18,48,.02) 50%,transparent 100%);pointer-events:none;}
.hero-img-box::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(10,9,8,.4) 0%,rgba(10,9,8,.1) 40%,transparent 70%);pointer-events:none;}

/* ─ Animations ─ */
@keyframes hs{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
@keyframes hl{from{width:0}to{width:56px}}
@keyframes bk{0%,100%{opacity:1}50%{opacity:.35}}
@keyframes sway{0%,100%{transform:translateY(0px)}50%{transform:translateY(3px)}}
.a0{animation:hs .9s .1s cubic-bezier(.22,1,.36,1) both}
.a1{animation:hs .9s .25s cubic-bezier(.22,1,.36,1) both}
.a2{animation:hs .9s .4s cubic-bezier(.22,1,.36,1) both}
.a3{animation:hs .9s .55s cubic-bezier(.22,1,.36,1) both}
.a4{animation:hs .9s .7s cubic-bezier(.22,1,.36,1) both}
.al{animation:hl .8s .35s cubic-bezier(.22,1,.36,1) both}
.asw{animation:sway 3s ease-in-out infinite;}

/* ─ Ticker ─ */
@keyframes tk{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.tkt{animation:tk 36s linear infinite;display:flex;white-space:nowrap;}

/* ─ Reveal ─ */
.rv{opacity:0;transform:translateY(24px);transition:opacity .9s cubic-bezier(.22,1,.36,1),transform .9s cubic-bezier(.22,1,.36,1);}
.rv.in{opacity:1;transform:none;}

/* ─ Profile Cell ─ */
.pc{position:relative;overflow:hidden;padding:3rem 2.25rem;background:#FAFAF8;transition:all .35s cubic-bezier(.22,1,.36,1);}
.pc::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2.5px;background:#C41230;transform:scaleY(0);transform-origin:bottom;transition:transform .45s cubic-bezier(.22,1,.36,1);}
.pc:hover{background:#FFF5F6;transform:translateY(-3px);}.pc:hover::before{transform:scaleY(1);}

/* ─ Org Node ─ */
.on{position:relative;overflow:hidden;background:#FAFAF8;border:1px solid #E8E6E4;border-radius:12px;padding:1.5rem 1.75rem;text-align:center;transition:all .35s cubic-bezier(.22,1,.36,1);}
.on::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2.5px;background:#C41230;transform:scaleX(0);transition:transform .4s cubic-bezier(.22,1,.36,1);}
.on:hover{background:#FFF5F6;border-color:rgba(196,18,48,.25);transform:translateY(-4px);box-shadow:0 8px 32px rgba(196,18,48,.08);}.on:hover::after{transform:scaleX(1);}

/* ─ Candidate Card ─ */
.cc{background:#FAFAF8;border:1px solid #E8E6E4;border-radius:14px;overflow:hidden;transition:all .4s cubic-bezier(.22,1,.36,1);}
.cc:hover{border-color:rgba(196,18,48,.2);box-shadow:0 16px 56px rgba(196,18,48,.12);transform:translateY(-6px);}
.vbar{transition:width 1.2s cubic-bezier(.22,1,.36,1);}

/* ─ Eyebrow ─ */
.ey{display:flex;align-items:center;gap:.75rem;margin-bottom:1rem;}
.ey-d{width:7px;height:7px;background:#C41230;border-radius:50%;flex-shrink:0;}
.ey-l{font-size:.58rem;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:#C41230;}

/* ─ Footer ─ */
footer{background:#080605;border-top:1px solid rgba(255,255,255,.04);}
.footer-content{max-width:1360px;margin:0 auto;padding:5rem 4rem 3rem;}
.footer-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:3rem;margin-bottom:3rem;}
.footer-col-left{border-right:1px solid rgba(255,255,255,.08);padding-right:3rem;}
.footer-divider{height:1px;background:rgba(255,255,255,.06);margin:2rem 0;}
.footer-col-mid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;}
.footer-links{display:flex;flex-direction:column;gap:.75rem;}
.footer-link{font-size:.65rem;color:rgba(255,255,255,.35);text-decoration:none;letter-spacing:.05em;transition:all .3s cubic-bezier(.22,1,.36,1);}
.footer-link:hover{color:#C41230;}
.footer-col-social{display:flex;flex-direction:column;gap:1.25rem;}
.footer-socials{display:flex;gap:1rem}
.social-btn{width:40px;height:40px;border:1.5px solid rgba(255,255,255,.15);border-radius:8px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.35);font-size:.65rem;font-weight:700;letter-spacing:.08em;text-decoration:none;transition:all .3s cubic-bezier(.22,1,.36,1);}
.social-btn:hover{border-color:#C41230;color:#C41230;background:rgba(196,18,48,.05);}
.footer-bottom{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:2rem;padding-top:2rem;border-top:1px solid rgba(255,255,255,.06);}
.footer-copy{font-size:.58rem;color:rgba(255,255,255,.15);letter-spacing:.04em;}
.footer-badge{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;background:rgba(196,18,48,.08);border:1px solid rgba(196,18,48,.15);border-radius:100px;font-size:.58rem;font-weight:600;color:#C41230;}

/* ─ Responsive ─ */
@media(max-width:1024px){
  .hero-grid{grid-template-columns:1fr;gap:2rem;padding:0 2.5rem;}
  .hero-right{display:none;}
  #nav{padding:0 2rem;}
  .footer-grid{grid-template-columns:1fr;gap:2rem;}
  .footer-col-left{border-right:none;border-bottom:1px solid rgba(255,255,255,.08);padding:0 0 2rem 0;}
}
@media(max-width:768px){
  #nav{height:64px;padding:0 1.25rem;}
  #beranda{padding-top:64px;}
  #beranda::before{width:400px;height:400px;left:-40%;}
  .hero-grid{min-height:calc(100svh - 64px);}
  .hero-left{padding:3rem 0;}
  #nav ul.hidden{display:none !important;}
}
</style>
